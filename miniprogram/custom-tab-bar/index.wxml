<view class="ios-tabbar">
  <view class="ios-tabbar__content">
    <view wx:for="{{tabs}}" wx:key="pagePath" class="tab-item {{selected === index ? 'tab-item--active' : ''}}" data-index="{{index}}" data-path="{{item.pagePath}}" bindtap="switchTab">
      <view class="tab-icon-wrap">
        <text class="tab-icon">{{item.icon}}</text>
        <text wx:if="{{index === 1 && badge}}" class="tab-badge">{{badge > 99 ? '99+' : badge}}</text>
      </view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
