.ios-tabbar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid rgba(60, 60, 67, 0.18);
  background: rgba(250, 250, 250, 0.96);
  box-shadow: 0 -8rpx 26rpx rgba(0, 0, 0, 0.035);
}

.ios-tabbar__content {
  display: grid;
  height: 104rpx;
  grid-template-columns: repeat(3, 1fr);
}

.tab-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #8e8e93;
}

.tab-icon-wrap {
  position: relative;
  min-width: 54rpx;
  height: 48rpx;
  text-align: center;
}

.tab-icon {
  font-size: 40rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.tab-text {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 560;
}

.tab-item--active {
  color: #007aff;
}

.tab-badge {
  position: absolute;
  top: -7rpx;
  right: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border: 3rpx solid #fafafa;
  border-radius: 18rpx;
  background: #ff3b30;
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}
