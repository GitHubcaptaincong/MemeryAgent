<view class="capture-page">
  <view wx:if="{{historyOpen}}" class="drawer-mask" bindtap="closeHistory"></view>
  <view class="session-drawer {{historyOpen ? 'session-drawer--open' : ''}}" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="drawer-header">
      <text>历史对话</text>
      <button class="app-icon-button drawer-close" aria-label="关闭历史对话" bindtap="closeHistory">×</button>
    </view>
    <button class="drawer-new-chat" disabled="{{busy}}" bindtap="newConversation">
      <view class="compose-icon compose-icon--small"><view class="compose-box"></view><view class="compose-stroke"></view></view>
      <text>新对话</text>
    </button>
    <scroll-view scroll-y enhanced show-scrollbar class="session-list">
      <block wx:for="{{conversationGroups}}" wx:key="label" wx:for-item="group">
        <text class="session-group-label">{{group.label}}</text>
        <view
          wx:for="{{group.items}}"
          wx:key="id"
          wx:for-item="session"
          class="session-item {{activeConversation && activeConversation.id === session.id ? 'session-item--active' : ''}}"
          data-id="{{session.id}}"
          bindtap="selectConversation"
        >
          <text class="session-title">{{session.title}}</text>
          <text class="session-meta">{{session.turn_count}} 次整理</text>
        </view>
      </block>
      <view wx:if="{{historyError}}" class="drawer-error">
        <text>{{historyError}}</text>
        <text bindtap="loadConversations">重试</text>
      </view>
      <view wx:elif="{{!conversations.length}}" class="drawer-empty">发送第一条消息后，对话会保存在这里。</view>
    </scroll-view>
  </view>

  <view class="top-app-bar" style="height: {{statusBarHeight + navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
    <button class="app-icon-button" aria-label="打开历史对话" bindtap="openHistory">
      <view class="menu-icon"><text></text><text></text><text></text></view>
    </button>
    <text class="app-bar-title">{{activeConversation ? activeConversation.title : '整理'}}</text>
    <button class="app-icon-button" aria-label="新建对话" disabled="{{busy}}" bindtap="newConversation">
      <view class="compose-icon"><view class="compose-box"></view><view class="compose-stroke"></view></view>
    </button>
  </view>

  <scroll-view
    class="conversation-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation
  >
    <view wx:if="{{error}}" class="inline-error">
      <text>{{error}}</text>
      <view class="inline-error-actions"><text bindtap="retryPage">重试</text><text bindtap="dismissError">关闭</text></view>
    </view>

    <view wx:if="{{!conversationTurns.length && !busy}}" class="centered-empty-state">
      <view class="brand-mark">M</view>
      <text class="empty-title">今天想记住什么？</text>
      <text class="empty-supporting">粘贴文章、链接，或者直接问我</text>
      <view class="quick-actions">
        <button data-placeholder="粘贴要总结的文章或链接…" bindtap="chooseQuickAction">总结文章</button>
        <button data-placeholder="写下你想记住的知识…" bindtap="chooseQuickAction">记录知识</button>
        <button data-placeholder="写下需要梳理的想法…" bindtap="chooseQuickAction">整理想法</button>
        <button data-placeholder="写下你想理解的问题…" bindtap="chooseQuickAction">问一个问题</button>
      </view>
    </view>

    <view class="conversation-content">
      <block wx:for="{{conversationTurns}}" wx:key="id">
        <view class="user-message-row">
          <view wx:if="{{item.isUrl}}" class="source-preview link-preview">
            <view class="source-icon">🌐</view>
            <view class="source-preview-copy">
              <text class="source-type">网页</text>
              <text class="source-title">{{item.hostname}}</text>
              <text class="source-meta">{{item.shortUrl}}</text>
            </view>
          </view>
          <view wx:elif="{{item.isLongText}}" class="source-preview document-preview">
            <view class="source-icon">📄</view>
            <view class="source-preview-copy">
              <text class="source-type">长文本 · {{item.charCount}} 字</text>
              <text class="document-copy {{item.expanded ? 'document-copy--expanded' : ''}}">{{item.expanded ? item.user_content : item.userPreview}}</text>
              <text class="source-action" data-id="{{item.id}}" bindtap="toggleTurnContent">{{item.expanded ? '收起原文' : '展开原文'}}</text>
            </view>
          </view>
          <view wx:else class="user-message">{{item.user_content}}</view>
        </view>

        <view wx:if="{{item.assistant_summary || item.draft}}" class="assistant-message-row">
          <view class="assistant-mark">M</view>
          <view class="assistant-content">
            <text class="intent-badge">知识整理</text>
            <text wx:if="{{item.assistant_summary}}" class="assistant-copy">{{item.assistant_summary}}</text>

            <view wx:if="{{item.draft}}" class="memory-result-card">
              <view class="result-heading">
                <view class="result-icon">🧠</view>
                <view><text>已整理 {{item.draft.units.length}} 条记忆</text><text>{{item.draft.units.length}} 个知识点 · {{item.draft.units.length}} 个复习问题</text></view>
              </view>
              <view class="result-preview-list">
                <text wx:for="{{item.draft.previewUnits}}" wx:key="id" wx:for-item="unit">{{unit.title}}</text>
              </view>
              <view class="result-toggle" data-id="{{item.draft.id}}" bindtap="toggleResult">
                <text>{{expandedResultId === item.draft.id ? '收起' : '查看全部'}}</text><text>{{expandedResultId === item.draft.id ? '⌃' : '›'}}</text>
              </view>

              <view wx:if="{{expandedResultId === item.draft.id}}" class="result-details">
                <view wx:for="{{item.draft.units}}" wx:key="id" wx:for-item="unit" class="result-unit">
                  <text class="result-unit-title">{{unit.position}}. {{unit.title}}</text>
                  <text class="result-unit-explanation">{{unit.explanation}}</text>
                  <view class="result-question"><text>复习问题</text><text>{{unit.question}}</text></view>
                  <text wx:if="{{unit.evidence.length}}" class="result-evidence">“{{unit.evidence[0].quote}}”</text>
                </view>
                <button
                  wx:if="{{draft && item.draft.id === draft.id && item.draft.status !== 'confirmed'}}"
                  class="confirm-result"
                  disabled="{{busy}}"
                  bindtap="confirmDraft"
                >确认并加入复习</button>
                <view wx:elif="{{item.draft.status === 'confirmed'}}" class="confirmed-result">✓ 已加入复习队列</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{busy}}" class="assistant-message-row processing-message">
        <view class="assistant-mark">M</view>
        <view class="assistant-content">
          <view class="inline-processing" bindtap="toggleTaskList"><view class="processing-dot"></view><text>{{currentActivity || '正在整理…'}}</text><text>{{tasksExpanded ? '⌃' : '⌄'}}</text></view>
          <view wx:if="{{tasksExpanded}}" class="processing-details">
            <view class="processing-progress"><view style="width: {{progress}}%;"></view></view>
            <scroll-view wx:if="{{events.length}}" scroll-y enhanced class="processing-events">
              <view wx:for="{{events}}" wx:key="id" class="processing-event"><text>{{item.label}}</text><text>{{item.clock}}</text></view>
            </scroll-view>
          </view>
        </view>
      </view>

      <block wx:if="{{memoryCandidates.length}}">
        <view wx:for="{{memoryCandidates}}" wx:key="id" class="memory-approval-card">
          <text class="memory-approval-label">长期记忆建议</text>
          <text class="memory-approval-content">{{item.content}}</text>
          <view class="memory-approval-actions">
            <button data-id="{{item.id}}" data-decision="reject" bindtap="decideMemory">忽略</button>
            <button data-id="{{item.id}}" data-decision="approve" bindtap="decideMemory">保存</button>
          </view>
        </view>
      </block>
      <view id="conversation-bottom" class="conversation-bottom"></view>
    </view>
  </scroll-view>

  <view class="composer-dock">
    <view class="message-composer">
      <textarea
        class="composer-textarea"
        value="{{content}}"
        maxlength="50000"
        auto-height
        focus="{{composerFocused}}"
        adjust-position
        cursor-spacing="132"
        placeholder="{{composerPlaceholder}}"
        bindinput="onContentInput"
        bindblur="onComposerBlur"
      ></textarea>
      <view class="composer-toolbar">
        <button class="toolbar-icon-button" aria-label="添加内容" bindtap="openAttachmentMenu">＋</button>
        <view class="composer-spacer"></view>
        <text wx:if="{{showCharCount}}" class="near-limit-count">{{charCount}} / 50000</text>
        <button class="send-button" aria-label="发送" disabled="{{busy || !content}}" bindtap="submitContent">↑</button>
      </view>
    </view>
  </view>

</view>
