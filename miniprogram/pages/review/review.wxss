.review-title {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.due-badge {
  flex: none;
  min-width: 118rpx;
  padding: 18rpx 16rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.04);
}

.due-badge text {
  display: block;
}

.due-badge text:first-child {
  color: #007aff;
  font-size: 42rpx;
  font-weight: 750;
}

.due-badge text:last-child {
  margin-top: 4rpx;
  color: #8e8e93;
  font-size: 21rpx;
}

.loading-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 70rpx 20rpx;
  color: #8e8e93;
  font-size: 26rpx;
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #007aff;
  box-shadow: 0 0 0 10rpx rgba(0, 122, 255, 0.1);
}

.plan-card {
  padding: 26rpx 28rpx;
}

.plan-card__top,
.plan-card__numbers,
.plan-card__footer,
.evaluation-heading,
.rating-button__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-card__top view text {
  display: block;
}

.plan-card__top view text:first-child {
  color: #007aff;
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.plan-card__top view text:last-child {
  margin-top: 5rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.plan-card__top > text,
.plan-card__footer text:last-child {
  color: #007aff;
  font-size: 22rpx;
  font-weight: 600;
}

.plan-card__numbers {
  justify-content: flex-start;
  margin-top: 24rpx;
  gap: 8rpx;
}

.plan-card__numbers text:first-child,
.plan-card__numbers text:nth-child(3) {
  font-size: 40rpx;
  font-weight: 750;
}

.plan-card__numbers text:nth-child(2) {
  color: #c7c7cc;
  font-size: 28rpx;
}

.plan-card__numbers text:last-child {
  margin-left: auto;
  color: #8e8e93;
  font-size: 21rpx;
}

.plan-progress {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #e5e5ea;
}

.plan-progress view {
  min-width: 8rpx;
  height: 100%;
  border-radius: 6rpx;
  background: #34c759;
  transition: width 200ms ease;
}

.plan-card__footer {
  margin-top: 16rpx;
}

.plan-card__footer text:first-child {
  color: #636366;
  font-size: 22rpx;
}

.empty-action {
  margin-top: 30rpx;
}

.empty-state__next {
  display: block;
  margin-top: 18rpx;
  color: #007aff;
  font-size: 24rpx;
  font-weight: 650;
}

.queue-strip {
  width: calc(100% + 56rpx);
  margin: 0 -28rpx 24rpx;
  white-space: nowrap;
}

.queue-strip__inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 28rpx 8rpx;
}

.queue-chip {
  display: grid;
  min-width: 280rpx;
  grid-template-columns: 48rpx 1fr;
  gap: 12rpx;
  align-items: center;
  padding: 20rpx;
  border: 1rpx solid #e5e5ea;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.03);
}

.queue-chip > text {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #f2f2f7;
  color: #8e8e93;
  font-size: 21rpx;
  font-weight: 650;
}

.queue-chip view text {
  display: block;
}

.queue-chip view text:first-child {
  max-width: 200rpx;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.queue-chip view text:last-child {
  margin-top: 5rpx;
  color: #8e8e93;
  font-size: 20rpx;
}

.queue-chip--active {
  border-color: #007aff;
  background: #007aff;
  color: #fff;
}

.queue-chip--active > text {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.queue-chip--active view text:last-child {
  color: rgba(255, 255, 255, 0.7);
}

.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.question-meta text:first-child {
  color: #007aff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.question-meta text:last-child {
  max-width: 330rpx;
  overflow: hidden;
  color: #8e8e93;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.question-title,
.question-goal {
  display: block;
}

.question-title {
  margin-top: 30rpx;
  color: #1c1c1e;
  font-size: 42rpx;
  font-weight: 740;
  letter-spacing: -1rpx;
  line-height: 1.35;
}

.question-goal {
  margin-top: 14rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.55;
}

.hint-button {
  margin: 24rpx 0 0;
  padding: 12rpx 0;
  background: transparent;
  color: #007aff;
  font-size: 25rpx;
  text-align: left;
}

.hint-box {
  margin-top: 8rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #fff8e6;
}

.hint-box view {
  display: grid;
  grid-template-columns: 38rpx 1fr;
  gap: 8rpx;
  padding: 7rpx 0;
  color: #7a5b00;
  font-size: 24rpx;
  line-height: 1.5;
}

.hint-box view text:first-child {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #ffd60a;
  color: #5c4400;
  font-size: 18rpx;
  font-weight: 700;
}

.answer-editor {
  position: relative;
  margin: 24rpx 0 20rpx;
  padding: 24rpx 24rpx 54rpx;
  border: 1rpx solid #d1d1d6;
  border-radius: 22rpx;
  background: #f9f9fb;
}

.answer-editor textarea {
  width: 100%;
  min-height: 260rpx;
  color: #1c1c1e;
  font-size: 29rpx;
  line-height: 1.65;
}

.answer-editor > text {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  color: #aeaeb2;
  font-size: 20rpx;
}

.compare-card {
  padding: 8rpx 0 0;
}

.compare-section {
  padding: 28rpx 30rpx;
}

.compare-label,
.compare-copy {
  display: block;
}

.compare-label {
  color: #8e8e93;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.compare-copy {
  margin-top: 16rpx;
  color: #3a3a3c;
  font-size: 27rpx;
  line-height: 1.65;
}

.answer-point {
  display: grid;
  grid-template-columns: 34rpx 1fr;
  gap: 10rpx;
  margin-top: 16rpx;
  color: #3a3a3c;
  font-size: 26rpx;
  line-height: 1.55;
}

.answer-point text:first-child {
  color: #34c759;
  font-weight: 700;
}

.evidence-card {
  margin: 0 20rpx 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.evidence-card text {
  display: block;
}

.evidence-card text:first-child {
  color: #007aff;
  font-size: 20rpx;
  font-weight: 700;
}

.evidence-card text:last-child {
  margin-top: 10rpx;
  color: #636366;
  font-size: 24rpx;
  line-height: 1.55;
}

.evaluation-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid #e5e5ea;
  box-shadow: none;
}

.evaluation-card--pending {
  background: #f7fbff;
  border-color: #cce5ff;
}

.evaluation-card--failed {
  background: #fff9f0;
  border-color: #ffe1b3;
}

.evaluation-card--done {
  border-color: #b8e8c3;
  background: #f7fcf8;
}

.evaluation-status {
  display: grid;
  grid-template-columns: 52rpx 1fr;
  gap: 18rpx;
  align-items: center;
}

.evaluation-status view:last-child text {
  display: block;
}

.evaluation-status view:last-child text:first-child {
  font-size: 28rpx;
  font-weight: 680;
}

.evaluation-status view:last-child text:last-child {
  margin-top: 7rpx;
  color: #636366;
  font-size: 22rpx;
  line-height: 1.5;
}

.evaluation-pulse,
.evaluation-fallback {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.evaluation-pulse {
  background: #007aff;
  box-shadow: 0 0 0 10rpx rgba(0, 122, 255, 0.1);
}

.evaluation-fallback {
  background: #e5e5ea;
  color: #636366;
  font-size: 24rpx;
  font-weight: 700;
}

.evaluation-heading > view text {
  display: inline;
}

.evaluation-heading > view text:first-child {
  color: #248a3d;
  font-size: 22rpx;
  font-weight: 700;
}

.evaluation-heading > view text:last-child {
  margin-left: 12rpx;
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 750;
}

.evaluation-heading > text {
  padding: 7rpx 12rpx;
  border-radius: 12rpx;
  background: #eaf8ee;
  color: #248a3d;
  font-size: 19rpx;
}

.evaluation-summary {
  display: block;
  margin-top: 18rpx;
  color: #3a3a3c;
  font-size: 25rpx;
  line-height: 1.6;
}

.evaluation-points {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #d7eadb;
}

.evaluation-points > text {
  color: #ff9500;
  font-size: 21rpx;
  font-weight: 700;
}

.evaluation-points > view {
  display: grid;
  grid-template-columns: 34rpx 1fr;
  gap: 10rpx;
  margin-top: 16rpx;
}

.evaluation-points > view > text {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: #fff0d9;
  color: #c66f00;
  font-size: 18rpx;
  font-weight: 700;
}

.evaluation-points view view text {
  display: block;
}

.evaluation-points view view text:first-child {
  color: #3a3a3c;
  font-size: 24rpx;
  line-height: 1.5;
}

.evaluation-points view view text:last-child {
  margin-top: 5rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.5;
}

.evaluation-complete {
  margin-top: 20rpx;
  color: #248a3d;
  font-size: 24rpx;
}

.rating-intro {
  margin: 0 8rpx 18rpx;
}

.rating-intro text {
  display: block;
}

.rating-intro text:first-child {
  font-size: 34rpx;
  font-weight: 720;
}

.rating-intro text:last-child {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 23rpx;
}

.rating-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.rating-button {
  min-height: 152rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff;
  text-align: left;
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.035);
}

.rating-button > text,
.rating-button__top text {
  display: block;
}

.rating-button__top text:first-child {
  font-size: 21rpx;
  font-weight: 700;
}

.rating-button__top text:last-child {
  padding: 5rpx 9rpx;
  border-radius: 10rpx;
  background: #e8f2ff;
  color: #007aff;
  font-size: 17rpx;
  font-weight: 700;
}

.rating-button > text:nth-child(2) {
  margin-top: 8rpx;
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 680;
}

.rating-button > text:last-child {
  margin-top: 7rpx;
  color: #8e8e93;
  font-size: 21rpx;
}

.rating-button--again .rating-button__top text:first-child { color: #ff3b30; }
.rating-button--hard .rating-button__top text:first-child { color: #ff9500; }
.rating-button--good .rating-button__top text:first-child { color: #007aff; }
.rating-button--easy .rating-button__top text:first-child { color: #34c759; }

.rating-button--recommended {
  border: 2rpx solid #007aff;
  box-shadow: 0 8rpx 28rpx rgba(0, 122, 255, 0.12);
}

.session-footer {
  padding: 34rpx 0 12rpx;
  color: #8e8e93;
  font-size: 23rpx;
  text-align: center;
}

.history-section {
  margin-top: 42rpx;
}

.history-section__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 8rpx 16rpx;
}

.history-section__heading view text {
  display: block;
}

.history-section__heading view text:first-child {
  color: #007aff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.history-section__heading view text:last-child {
  margin-top: 8rpx;
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 720;
}

.history-section__heading > text {
  color: #8e8e93;
  font-size: 21rpx;
}

.history-card {
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

.history-item:last-child {
  border-bottom: 0;
}

.history-item view {
  min-width: 0;
}

.history-item view text,
.history-item > text {
  display: block;
}

.history-item view text:first-child {
  max-width: 410rpx;
  overflow: hidden;
  color: #1c1c1e;
  font-size: 26rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item view text:last-child,
.history-item > text {
  margin-top: 7rpx;
  color: #8e8e93;
  font-size: 20rpx;
}

.history-item > text {
  flex: none;
  margin-top: 0;
  text-align: right;
}
.section-tabs { display: flex; width: 300rpx; margin-bottom: 30rpx; padding: 6rpx; border-radius: 32rpx; background: #e9e9ee; }
.section-tabs view { flex: 1; padding: 13rpx 0; border-radius: 26rpx; color: #636366; font-size: 24rpx; font-weight: 650; text-align: center; }
.section-tabs view.active { background: #fff; color: #111; box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, .08); }
.knowledge-back { margin-bottom: 24rpx; color: #007aff; font-size: 25rpx; font-weight: 650; }
.knowledge-heading { position: relative; margin-bottom: 28rpx; }
.knowledge-heading > text { display: block; }
.knowledge-heading > text:first-child, .knowledge-list-heading view > text:first-child { color: #007aff; font-size: 19rpx; font-weight: 750; letter-spacing: 2rpx; }
.knowledge-heading > text:nth-child(2) { margin-top: 8rpx; padding-right: 150rpx; font-size: 46rpx; font-weight: 750; }
.knowledge-heading > text:nth-child(3) { margin-top: 12rpx; color: #636366; font-size: 24rpx; line-height: 1.6; }
.knowledge-heading button { position: absolute; top: 30rpx; right: 0; margin: 0; padding: 8rpx 16rpx; border: 1rpx solid #d1d1d6; border-radius: 16rpx; background: #fff; font-size: 23rpx; line-height: 1.5; }
.knowledge-heading button::after, .knowledge-actions button::after, .knowledge-delete::after { border: 0; }
.knowledge-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.knowledge-stats view { padding: 22rpx; border-radius: 20rpx; background: #fff; }
.knowledge-stats text { display: block; }
.knowledge-stats text:first-child { font-size: 29rpx; font-weight: 720; }
.knowledge-stats text:last-child { margin-top: 6rpx; color: #8e8e93; font-size: 20rpx; }
.knowledge-source { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; }
.knowledge-source view text { display: block; }
.knowledge-source view text:first-child { color: #8e8e93; font-size: 20rpx; }
.knowledge-source view text:last-child { margin-top: 5rpx; font-size: 25rpx; font-weight: 650; }
.knowledge-source > text { color: #007aff; font-size: 22rpx; }
.knowledge-start { margin: 22rpx 0 34rpx; }
.knowledge-units { display: grid; gap: 14rpx; }
.knowledge-unit { overflow: hidden; }
.knowledge-unit__top { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; }
.knowledge-unit__top > text:first-child { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 14rpx; background: #eef6ff; color: #007aff; font-size: 20rpx; font-weight: 700; }
.knowledge-unit__top > view { flex: 1; }
.knowledge-unit__top view text { display: block; }
.knowledge-unit__top view text:first-child { font-size: 27rpx; font-weight: 650; line-height: 1.45; }
.knowledge-unit__top view text:last-child { margin-top: 7rpx; color: #8e8e93; font-size: 20rpx; }
.knowledge-unit__top > text:last-child { color: #8e8e93; }
.knowledge-unit__body { padding: 0 24rpx 24rpx 84rpx; color: #3a3a3c; font-size: 25rpx; line-height: 1.65; white-space: pre-wrap; }
.knowledge-evidence { margin-top: 18rpx; padding: 18rpx; border-left: 5rpx solid #007aff; background: #f2f7fc; color: #636366; }
.knowledge-actions { display: flex; margin-top: 18rpx; gap: 16rpx; }
.knowledge-actions button { margin: 0; padding: 0; background: transparent; color: #007aff; font-size: 23rpx; line-height: 1.5; }
.knowledge-actions button:last-child { color: #d70015; }
.knowledge-delete { margin: 36rpx 0 10rpx; background: transparent; color: #d70015; font-size: 24rpx; }
.knowledge-list-heading { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 26rpx; }
.knowledge-list-heading view > text { display: block; }
.knowledge-list-heading view > text:nth-child(2) { margin-top: 8rpx; font-size: 48rpx; font-weight: 750; }
.knowledge-list-heading view > text:nth-child(3) { margin-top: 10rpx; color: #636366; font-size: 23rpx; line-height: 1.5; }
.knowledge-list-heading > text { flex: none; font-size: 30rpx; font-weight: 700; }
.knowledge-empty { padding: 70rpx 30rpx; text-align: center; }
.knowledge-empty > text { display: block; }
.knowledge-empty > text:first-child { font-size: 32rpx; font-weight: 700; }
.knowledge-empty > text:nth-child(2) { margin: 12rpx 0 28rpx; color: #8e8e93; font-size: 23rpx; }
.knowledge-set-list { display: grid; gap: 16rpx; }
.knowledge-set-card { display: flex; justify-content: space-between; gap: 20rpx; padding: 28rpx; }
.knowledge-set-card view text { display: block; }
.knowledge-set-card view text:first-child { color: #8e8e93; font-size: 20rpx; }
.knowledge-set-card view text:nth-child(2) { margin: 10rpx 0; font-size: 31rpx; font-weight: 700; }
.knowledge-set-card view text:nth-child(n+3) { margin-top: 7rpx; color: #636366; font-size: 22rpx; }
.knowledge-set-card > text { align-self: center; color: #007aff; font-size: 36rpx; }
