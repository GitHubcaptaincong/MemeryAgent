<view class="page-shell review-page">
  <view class="section-tabs"><view class="{{section === 'practice' ? 'active' : ''}}" bindtap="showPractice">复习</view><view class="{{section === 'knowledge' ? 'active' : ''}}" bindtap="showKnowledgeSets">知识集</view></view>
  <block wx:if="{{section === 'practice'}}">
  <view class="large-title review-title">
    <view>
      <text class="large-title__eyebrow">ACTIVE RECALL</text>
      <text class="large-title__heading">先讲出来。</text>
      <text class="large-title__copy">不要先看答案。用自己的话说一遍，再检查遗漏。</text>
    </view>
    <view class="due-badge"><text>{{overview.due_count}}</text><text>待复习</text></view>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <view wx:if="{{lastScheduleText}}" class="success-banner">✓ {{lastScheduleText}}</view>

  <view wx:if="{{!loading && !planAvailable}}" class="ios-card plan-card">
    <view class="plan-card__top">
      <view><text>TODAY</text><text>今日计划暂不可用</text></view>
    </view>
    <view class="plan-card__footer">
      <text>云端服务正在更新，当前已按全部到期内容展示，复习仍可正常进行。</text>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="ios-card plan-card">
    <view class="plan-card__top">
      <view><text>TODAY</text><text>今日计划</text></view>
      <text bindtap="goToInsights">学习统计 ›</text>
    </view>
    <view class="plan-card__numbers">
      <text>{{dailyPlan.completed_today}}</text><text>/</text><text>{{dailyPlan.completed_today + dailyPlan.planned_count}}</text>
      <text>建议上限 {{dailyPlan.daily_limit}}</text>
    </view>
    <view class="plan-progress"><view style="width: {{dailyPlan.progress_percent}}%;"></view></view>
    <view class="plan-card__footer">
      <text wx:if="{{dailyPlan.planned_count}}">还建议完成 {{dailyPlan.planned_count}} 题</text>
      <text wx:else>今天的建议计划已完成</text>
      <text wx:if="{{showAllDue}}" bindtap="showTodayPlan">返回今日计划 ›</text>
      <text wx:elif="{{dailyPlan.overflow_count}}" bindtap="showAllDueCards">另有 {{dailyPlan.overflow_count}} 题到期 ›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="ios-card loading-card">
    <view class="loading-dot"></view><text>正在同步复习队列</text>
  </view>

  <view wx:elif="{{!queue.length}}" class="ios-card empty-state">
    <view class="empty-state__icon">✓</view>
    <text class="empty-state__title">今天已经清空</text>
    <text class="empty-state__copy">{{dailyPlan.overflow_count ? '今日建议量已完成，其余到期内容仍可继续复习。' : '新确认的知识会自动出现在这里；完成自评后，系统会安排下次复习。'}}</text>
    <text wx:if="{{overview.next_due_at}}" class="empty-state__next">下一次复习：{{overview.next_due_label}}</text>
    <button wx:if="{{dailyPlan.overflow_count}}" class="ios-button empty-action" bindtap="showAllDueCards">继续全部到期内容</button>
    <button class="ios-button ios-button--plain empty-action" bindtap="goToCapture">记录新内容</button>
  </view>

  <block wx:else>
    <scroll-view class="queue-strip" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="queue-strip__inner">
        <view wx:for="{{queue}}" wx:key="id" class="queue-chip {{activeIndex === index ? 'queue-chip--active' : ''}}" data-index="{{index}}" bindtap="selectCard">
          <text>{{index + 1}}</text>
          <view><text>{{item.title}}</text><text>第 {{item.review_count + 1}} 次</text></view>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{activeCard}}" class="ios-card question-card card-padding">
      <view class="question-meta"><text>OPEN QUESTION</text><text>{{activeCard.source_title}}</text></view>
      <text class="question-title">{{activeCard.question}}</text>
      <text class="question-goal">目标：{{activeCard.learning_goal}}</text>

      <view wx:if="{{!answerResult}}">
        <button wx:if="{{activeCard.hints.length}}" class="hint-button" bindtap="toggleHints">{{hintsVisible ? '收起提示' : '需要一点提示？'}}</button>
        <view wx:if="{{hintsVisible}}" class="hint-box">
          <view wx:for="{{activeCard.hints}}" wx:key="*this"><text>{{index + 1}}</text><text>{{item}}</text></view>
        </view>
        <view class="answer-editor">
          <textarea value="{{answer}}" maxlength="3000" auto-height="{{false}}" placeholder="把你记得的机制、原因或步骤讲出来……" bindinput="onAnswerInput"></textarea>
          <text>{{answer.length}} 字</text>
        </view>
        <button class="ios-button" disabled="{{busy || !answer}}" bindtap="submitAnswer">{{busy ? '正在保存…' : '提交回答'}}</button>
      </view>
    </view>

    <block wx:if="{{answerResult}}">
      <text class="section-label">对照答案</text>
      <view class="ios-card compare-card">
        <view class="compare-section">
          <text class="compare-label">你的回答</text>
          <text class="compare-copy">{{answerResult.answer}}</text>
        </view>
        <view class="hairline"></view>
        <view class="compare-section">
          <text class="compare-label blue">答案要点</text>
          <view wx:for="{{answerResult.answer_key}}" wx:key="*this" class="answer-point"><text>✓</text><text>{{item}}</text></view>
        </view>
        <view wx:if="{{answerResult.evidence.length}}" class="evidence-card"><text>原文证据</text><text>“{{answerResult.evidence[0].quote}}”</text></view>
      </view>

      <text class="section-label">AI 回答评估</text>
      <view wx:if="{{answerResult.evaluation_status === 'pending'}}" class="ios-card evaluation-card evaluation-card--pending">
        <view class="evaluation-status"><view class="evaluation-pulse"></view><view><text>正在检查要点覆盖</text><text>{{evaluationWaitingLong ? '模型仍在处理，你可以先完成自评，结果不会阻塞复习。' : 'AI 建议稍后自动出现；四个评分按钮现在就可以使用。'}}</text></view></view>
      </view>
      <view wx:elif="{{answerResult.evaluation_status === 'failed'}}" class="ios-card evaluation-card evaluation-card--failed">
        <view class="evaluation-status"><view class="evaluation-fallback">!</view><view><text>AI 评估暂时不可用</text><text>这不会影响复习，请根据答案要点完成最终评分。</text></view></view>
      </view>
      <view wx:elif="{{answerResult.evaluation_status === 'disabled'}}" class="ios-card evaluation-card">
        <view class="evaluation-status"><view class="evaluation-fallback">—</view><view><text>AI 评估已关闭</text><text>你可以在“提醒”页随时重新开启。</text></view></view>
      </view>
      <view wx:elif="{{answerResult.evaluation_status === 'completed'}}" class="ios-card evaluation-card evaluation-card--done">
        <view class="evaluation-heading">
          <view><text>AI 建议等级</text><text>{{answerResult.evaluation.suggested_rating}} / 4</text></view>
          <text>仅供参考</text>
        </view>
        <text class="evaluation-summary">{{answerResult.evaluation.summary}}</text>
        <view wx:if="{{answerResult.evaluation.missing_points.length}}" class="evaluation-points">
          <text>建议补充</text>
          <view wx:for="{{answerResult.evaluation.missing_points}}" wx:key="point_index"><text>{{index + 1}}</text><view><text>{{item.point}}</text><text>{{item.suggestion}}</text></view></view>
        </view>
        <view wx:else class="evaluation-complete">✓ 答案要点已全部覆盖</view>
      </view>

      <text class="section-label">你的最终判断</text>
      <view class="rating-intro"><text>掌握得怎么样？</text><text>当前由你最终评分，AI 不会覆盖这个选择。</text></view>
      <view class="rating-grid">
        <button wx:for="{{ratings}}" wx:key="value" class="rating-button rating-button--{{item.tone}} {{item.recommendedClass}}" disabled="{{busy}}" data-rating="{{item.value}}" bindtap="rateAnswer">
          <view class="rating-button__top"><text>{{item.value}}</text><text wx:if="{{item.recommended}}">AI 建议</text></view><text>{{item.label}}</text><text>{{item.hint}}</text>
        </button>
      </view>
    </block>

    <view class="session-footer">本次已完成 {{sessionCount}} 题</view>
  </block>

  <view wx:if="{{history.length}}" class="history-section">
    <view class="history-section__heading"><view><text>RECENT REVIEWS</text><text>最近复习</text></view><text>最近 {{history.length}} 条</text></view>
    <view class="ios-card history-card">
      <view wx:for="{{history}}" wx:key="id" class="history-item">
        <view><text>{{item.title}}</text><text>{{item.source_title}} · {{item.rating === 1 ? '忘记了' : item.rating === 2 ? '有点难' : item.rating === 3 ? '掌握了' : '很轻松'}}</text></view>
        <text>下次 {{item.next_due_label}}</text>
      </view>
    </view>
  </view>
  </block>

  <block wx:else>
    <view wx:if="{{error}}" class="error-banner">{{error}}</view>
    <view wx:if="{{loading}}" class="ios-card loading-card"><view class="loading-dot"></view><text>正在同步知识集</text></view>
    <block wx:elif="{{knowledgeDetail}}">
      <view class="knowledge-back" bindtap="backToKnowledgeSets">‹ 返回知识集</view>
      <view class="knowledge-heading"><text>KNOWLEDGE SET</text><text>{{knowledgeDetail.title}}</text><text>{{knowledgeDetail.learning_goal}}</text><button bindtap="renameKnowledgeSet">编辑标题</button></view>
      <view class="knowledge-stats">
        <view><text>{{knowledgeDetail.unit_count}}</text><text>知识点</text></view><view><text>{{knowledgeDetail.review_count}}</text><text>累计知识点复习</text></view><view><text>{{knowledgeDetail.last_reviewed_label}}</text><text>最近复习</text></view><view><text>{{knowledgeDetail.created_label}}</text><text>创建时间</text></view>
      </view>
      <view class="ios-card knowledge-source"><view><text>来源</text><text>{{knowledgeDetail.source_label}}</text></view><text wx:if="{{knowledgeDetail.source.origin_url}}" bindtap="copySourceUrl">复制原文链接 ›</text></view>
      <button class="ios-button knowledge-start" disabled="{{!knowledgeDetail.due_count}}" bindtap="startKnowledgeSetReview">{{knowledgeDetail.due_count ? '开始复习（' + knowledgeDetail.due_count + ' 个到期）' : '当前没有到期知识'}}</button>
      <text class="section-label">知识点</text>
      <view class="knowledge-units">
        <view wx:for="{{knowledgeDetail.units}}" wx:key="id" class="ios-card knowledge-unit">
          <view class="knowledge-unit__top" data-id="{{item.id}}" bindtap="toggleKnowledgeUnit"><text>{{index + 1}}</text><view><text>{{item.question}}</text><text>累计复习 {{item.review_count}} 次</text></view><text>{{expandedUnitId === item.id ? '⌃' : '⌄'}}</text></view>
          <view wx:if="{{expandedUnitId === item.id}}" class="knowledge-unit__body"><text>{{item.answer}}</text><view wx:if="{{item.evidence.length}}" class="knowledge-evidence">“{{item.evidence[0].quote}}”</view><view class="knowledge-actions"><button data-id="{{item.id}}" bindtap="editKnowledgeUnit">编辑问答</button><button data-id="{{item.id}}" bindtap="deleteKnowledgeUnit">删除知识点</button></view></view>
        </view>
      </view>
      <button class="knowledge-delete" bindtap="deleteKnowledgeSet">删除整个知识集</button>
    </block>
    <block wx:else>
      <view class="knowledge-list-heading"><view><text>KNOWLEDGE LIBRARY</text><text>知识集</text><text>每次确认整理结果后，这批知识会作为一个整体保存在这里。</text></view><text>{{knowledgeSets.length}} 组</text></view>
      <view wx:if="{{!knowledgeSets.length}}" class="ios-card knowledge-empty"><text>还没有知识</text><text>整理一段内容并确认后，会出现在这里。</text><button class="ios-button" bindtap="goToCapture">去整理内容</button></view>
      <view wx:else class="knowledge-set-list"><view wx:for="{{knowledgeSets}}" wx:key="id" class="ios-card knowledge-set-card" data-id="{{item.id}}" bindtap="openKnowledgeSet"><view><text>{{item.created_label}}</text><text>{{item.title}}</text><text>{{item.unit_count}} 个知识点 · 累计复习 {{item.review_count}} 次</text><text>最近复习：{{item.last_reviewed_label}}</text><text>来源：{{item.source_label}}</text></view><text>›</text></view></view>
    </block>
  </block>
</view>
