<view class="page-shell reminders-page">
  <view class="large-title">
    <text class="large-title__eyebrow">PREFERENCES</text>
    <text class="large-title__heading">设置</text>
    <text class="large-title__copy">安排复习节奏，选择提醒方式与 AI 辅助。</text>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>
  <view wx:if="{{saved}}" class="success-banner">✓ 复习与 AI 辅助设置已保存</view>
  <view wx:elif="{{dirty}}" class="settings-unsaved">有未保存的修改，请点击“保存设置”生效。</view>

  <view wx:if="{{loading}}" class="ios-card loading-settings">正在读取设置…</view>

  <block wx:else>
    <button wx:if="{{!preferencesAvailable}}" class="ios-button ios-button--plain" bindtap="loadPreferences">重新读取设置</button>
    <text class="section-label">复习提醒</text>
    <view class="ios-card settings-group">
      <view class="setting-row">
        <view class="setting-copy"><text>启用复习提醒</text><text>关闭提醒后，仍可手动复习和使用 AI 建议</text></view>
        <switch checked="{{form.enabled}}" disabled="{{saving || !preferencesAvailable}}" color="#34C759" bindchange="onEnabledChange" />
      </view>
      <view class="hairline"></view>
      <picker mode="time" value="{{form.preferred_time}}" disabled="{{!form.enabled || saving || !preferencesAvailable}}" bindchange="onTimeChange">
        <view class="setting-row {{!form.enabled ? 'setting-row--disabled' : ''}}">
          <view class="setting-copy"><text>提醒时间</text><text>每天优先开始复习的时间</text></view>
          <view class="setting-value"><text>{{form.preferred_time}}</text><text>›</text></view>
        </view>
      </picker>
      <view class="hairline"></view>
      <view class="setting-row {{!form.enabled ? 'setting-row--disabled' : ''}}">
        <view class="setting-copy"><text>提醒中包含逾期</text><text>关闭后逾期卡仍保留在“全部到期”中</text></view>
        <switch checked="{{form.overdue_enabled}}" disabled="{{!form.enabled || saving || !preferencesAvailable}}" color="#34C759" bindchange="onOverdueChange" />
      </view>
    </view>

    <text class="section-label">复习计划</text>
    <view class="ios-card settings-group">
      <view class="limit-setting">
        <view class="limit-heading">
          <view class="setting-copy"><text>每日建议上限</text><text>控制今日建议题量，不改变每题的下次复习时间</text></view>
          <text class="limit-value">{{form.daily_limit}} 题</text>
        </view>
        <view class="limit-slider-row">
          <text>1</text>
          <slider
            class="limit-slider"
            min="1"
            max="100"
            step="1"
            value="{{form.daily_limit}}"
            disabled="{{saving || !preferencesAvailable}}"
            activeColor="#007AFF"
            backgroundColor="#D1D1D6"
            block-color="#FFFFFF"
            block-size="24"
            bindchanging="onLimitChanging"
            bindchange="onLimitChange"
          />
          <text>100</text>
        </view>
      </view>
    </view>

    <text class="section-label">AI 辅助</text>
    <view class="ios-card settings-group">
      <view class="setting-row">
        <view class="setting-copy"><text>回答后给出 AI 建议</text><text>分析遗漏要点并建议评分；是否开启都由你最终自评</text></view>
        <switch checked="{{form.ai_evaluation_enabled}}" disabled="{{saving || !preferencesAvailable}}" color="#34C759" bindchange="onAiEvaluationChange" />
      </view>
    </view>

    <text class="section-label">地区</text>
    <view class="ios-card settings-group">
      <view class="setting-row">
        <view class="setting-copy"><text>时区</text><text>自动读取设备，无法识别时使用亚洲上海</text></view>
        <text class="timezone">{{form.timezone}}</text>
      </view>
    </view>

    <button class="ios-button save-button" disabled="{{saving || !preferencesAvailable}}" bindtap="savePreferences">{{saving ? '正在保存…' : '保存设置'}}</button>

    <text class="section-label">微信订阅提醒</text>
    <view class="ios-card subscription-card">
      <view wx:if="{{!subscriptionStatusAvailable}}" class="subscription-heading">
        <view class="delivery-icon">!</view>
        <view><text>订阅状态读取失败</text><text>{{subscriptionStatusError || '云端服务暂时不可用，提醒偏好仍可正常保存。'}}</text></view>
      </view>
      <button wx:if="{{!subscriptionStatusAvailable}}" class="ios-button ios-button--plain subscription-retry-button" bindtap="loadPreferences">重新读取订阅状态</button>
      <block wx:else>
      <view class="subscription-heading">
        <view class="delivery-icon {{subscription.delivery_enabled ? 'delivery-icon--ready' : ''}}">{{subscription.delivery_enabled ? '✓' : '!'}}</view>
        <view><text>{{subscription.delivery_enabled ? '定时发送已就绪' : '发送服务尚未启用'}}</text><text>{{subscription.template_id ? '每次授权可发送一次到期提醒' : '请先在服务端配置订阅消息模板 ID'}}</text></view>
      </view>
      <view class="grant-count"><text>{{subscription.available_grants}}</text><view><text>可用提醒次数</text><text>{{subscription.available_grants > 0 ? '当前已有可用授权；发送成功后消耗一次' : '当前暂无可用授权，点击下方按钮授权一次'}}</text></view></view>
      <button
        class="ios-button subscribe-button"
        disabled="{{subscribing || !subscriptionAuthorizationEnabled || !subscription.template_id}}"
        bindtap="requestSubscription"
      >{{subscribing ? '正在请求授权…' : (subscriptionAuthorizationEnabled && subscription.template_id ? (subscription.delivery_enabled ? '授权一次复习提醒' : '先授权提醒额度') : (subscription.template_id ? '订阅授权暂不可用' : '订阅模板未配置'))}}</button>
      <text wx:if="{{subscriptionFeedback}}" class="subscription-feedback subscription-feedback--{{subscriptionFeedbackType}}">{{subscriptionFeedback}}</text>
      <text wx:if="{{subscription.last_sent_label}}" class="last-delivery">上次发送：{{subscription.last_sent_label}} · {{subscription.last_delivery_status}}</text>
      </block>
    </view>

    <view class="scope-card">
      <text>授权与发送</text>
      <text>授权只增加可用提醒次数，不代表消息已发送。开启提醒并保存设置后，有到期内容且发送服务可用时才会提醒你。</text>
    </view>
  </block>
</view>
