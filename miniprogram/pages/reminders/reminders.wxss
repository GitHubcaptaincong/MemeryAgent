.loading-settings {
  padding: 70rpx 28rpx;
  color: #8e8e93;
  font-size: 26rpx;
  text-align: center;
}

.settings-group {
  margin-bottom: 14rpx;
}

.setting-row {
  display: flex;
  min-height: 120rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 30rpx;
}

.setting-row--disabled {
  opacity: 0.42;
}

.setting-copy text {
  display: block;
}

.setting-copy text:first-child {
  color: #1c1c1e;
  font-size: 29rpx;
  font-weight: 620;
}

.setting-copy text:last-child {
  margin-top: 7rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.4;
}

.setting-value {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
  color: #8e8e93;
  font-size: 27rpx;
}

.setting-value text:last-child {
  color: #c7c7cc;
  font-size: 38rpx;
}

.limit-setting {
  padding: 28rpx 30rpx 24rpx;
}

.limit-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.limit-value {
  flex: none;
  min-width: 94rpx;
  color: #007aff;
  font-size: 29rpx;
  font-weight: 700;
  text-align: right;
}

.limit-slider-row {
  display: grid;
  grid-template-columns: 42rpx 1fr 58rpx;
  align-items: center;
  gap: 2rpx;
  margin-top: 20rpx;
}

.limit-slider-row > text {
  color: #8e8e93;
  font-size: 21rpx;
  text-align: center;
}

.limit-slider {
  margin: 0;
}

.timezone {
  color: #8e8e93;
  font-size: 25rpx;
}

.save-button {
  margin-top: 28rpx;
}

.delivery-card {
  padding: 8rpx 0;
}

.delivery-row {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 20rpx;
  align-items: start;
  padding: 26rpx 30rpx;
}

.delivery-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #e5e5ea;
  color: #636366;
  font-size: 23rpx;
  font-weight: 700;
}

.delivery-row--done .delivery-icon {
  background: #eaf8ee;
  color: #34c759;
}

.delivery-icon--ready {
  background: #eaf8ee;
  color: #34c759;
}

.delivery-row > view:last-child text {
  display: block;
}

.delivery-row > view:last-child text:first-child {
  font-size: 29rpx;
  font-weight: 650;
}

.delivery-row > view:last-child text:last-child {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 23rpx;
  line-height: 1.5;
}

.delivery-line {
  margin-left: 114rpx;
}

.subscription-card {
  padding: 28rpx 30rpx;
}

.subscription-heading,
.grant-count {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 20rpx;
  align-items: center;
}

.subscription-heading > view:last-child text,
.grant-count view text {
  display: block;
}

.subscription-heading > view:last-child text:first-child {
  font-size: 29rpx;
  font-weight: 680;
}

.subscription-heading > view:last-child text:last-child {
  margin-top: 7rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.45;
}

.grant-count {
  grid-template-columns: 96rpx 1fr;
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f2f2f7;
}

.grant-count > text {
  color: #007aff;
  font-size: 50rpx;
  font-weight: 760;
  text-align: center;
}

.grant-count view text:first-child {
  font-size: 25rpx;
  font-weight: 650;
}

.grant-count view text:last-child {
  margin-top: 5rpx;
  color: #8e8e93;
  font-size: 20rpx;
  line-height: 1.45;
}

.subscribe-button {
  margin-top: 24rpx;
}

.subscribe-button[disabled] {
  background: #d1d1d6;
  color: #8e8e93;
  opacity: 1;
}

.last-delivery {
  display: block;
  margin-top: 18rpx;
  color: #8e8e93;
  font-size: 21rpx;
  text-align: center;
}

.scope-card {
  margin: 24rpx 8rpx 0;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #e8f2ff;
}

.scope-card text {
  display: block;
}

.scope-card text:first-child {
  color: #007aff;
  font-size: 23rpx;
  font-weight: 700;
}

.scope-card text:last-child {
  margin-top: 8rpx;
  color: #3d6f9f;
  font-size: 23rpx;
  line-height: 1.55;
}
