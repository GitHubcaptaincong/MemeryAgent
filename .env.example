APP_ENV=development
APP_DATABASE_URL=postgresql+psycopg://memory_agent:memory_agent@localhost:5432/memory_agent
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_AUTH_MODE=local
APP_LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
APP_LOCAL_USER_EMAIL=local@memory-agent.test
# CloudBase deployment only. Keep local mode for direct local/H5 development.
# APP_AUTH_MODE=wechat
# APP_WECHAT_APP_ID=wx_your_miniprogram_app_id
# Enable for the first private request only, then set it back to false.
# APP_WECHAT_CLAIM_LOCAL_USER=false
# Safer alternative to first-request claiming when the OpenID is already known:
# APP_WECHAT_LEGACY_OWNER_OPENID=
APP_MODEL_PROVIDER=cli_proxy
APP_MODEL_BASE_URL=http://127.0.0.1:8317/v1
APP_MODEL_API_KEY=replace-with-local-proxy-key
APP_MODEL_NAME=gpt-5.4-mini
APP_MODEL_REASONING_EFFORT=low
APP_MODEL_TIMEOUT_SECONDS=180
APP_MODEL_MAX_OUTPUT_TOKENS=8000
APP_MODEL_QUICK_SOURCE_MAX_CHARS=600
APP_MODEL_QUICK_REASONING_EFFORT=none
APP_MODEL_QUICK_MAX_OUTPUT_TOKENS=2500
# Answer evaluation uses one short Responses call and never controls FSRS.
APP_ANSWER_EVALUATION_TIMEOUT_SECONDS=15
APP_ANSWER_EVALUATION_MAX_OUTPUT_TOKENS=1000
APP_ANSWER_EVALUATION_REASONING_EFFORT=none
APP_WEB_ACCESS_DEFAULT=false
APP_AGENT_MAX_TOOL_CALLS=12
APP_AGENT_MAX_WEB_SEARCHES=2
APP_AGENT_MAX_REVISIONS=2
APP_AGENT_MAX_SECONDS=120
APP_AUTO_CREATE_SCHEMA=false
# WeChat one-time subscription reminders. Keep disabled until the real
# template ID, shared dispatch token, and scheduled cloud function are ready.
APP_REMINDER_DELIVERY_ENABLED=false
# APP_REMINDER_DISPATCH_TOKEN=replace-with-a-long-random-secret
# APP_WECHAT_SUBSCRIBE_TEMPLATE_ID=replace-with-real-template-id
# The actual template field map belongs to the scheduled cloud function:
# WECHAT_TEMPLATE_FIELD_MAP_JSON={"due_count":"number1","reminder_time":"time2","summary":"thing3"}
APP_WECHAT_SUBSCRIBE_PAGE=pages/review/review
APP_REMINDER_BATCH_SIZE=50
APP_REMINDER_LEASE_SECONDS=120
CLI_PROXY_API_KEY=replace-with-local-proxy-key
CLI_PROXY_MODEL=gpt-5.4-mini
CLI_PROXY_REASONING_EFFORT=low
CLI_PROXY_QUICK_SOURCE_MAX_CHARS=600
CLI_PROXY_QUICK_REASONING_EFFORT=none
CLI_PROXY_QUICK_MAX_OUTPUT_TOKENS=2500
VITE_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_DEMO=false
VITE_BASE_PATH=/
